{
  "schema_version": 1,
  "name": "compaction",
  "cases": [
    {
      "name": "fact from the compacted span survives",
      "task": "Write service.conf with the release port.",
      "compact_after_messages": 10,
      "script": [
        {
          "content": "The release port from the task notes is 7341. Writing the notes file first.",
          "tool_calls": [
            {
              "name": "write_file",
              "args_json": "{\"path\": \"notes.txt\", \"content\": \"draft\"}"
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "write_file",
              "args_json": "{\"path\": \"a.txt\", \"content\": \"a\"}"
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "write_file",
              "args_json": "{\"path\": \"b.txt\", \"content\": \"b\"}"
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "write_file",
              "args_json": "{\"path\": \"c.txt\", \"content\": \"c\"}"
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "write_file",
              "args_json": "{\"path\": \"d.txt\", \"content\": \"d\"}"
            }
          ]
        },
        {
          "summary": "Task: write the service config. Found earlier: the release port is 7341. Files written so far: notes.txt, a.txt."
        },
        {
          "requires_context": [
            "7341"
          ],
          "tool_calls": [
            {
              "name": "write_file",
              "args_json": "{\"path\": \"service.conf\", \"content\": \"port=7341\\n\"}"
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "report",
              "args_json": "{\"summary\": \"config written\", \"success\": true}"
            }
          ]
        }
      ],
      "summary_contains": [
        "config written"
      ],
      "expect_files": [
        {
          "path": "service.conf",
          "contains": "port=7341"
        }
      ]
    }
  ]
}
