{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && ./scripts/verify.sh verify --all --json",
            "timeout": 3600,
            "statusMessage": "Running deterministic project verification"
          }
        ]
      }
    ]
  }
}
